<div class="container col-md-5 mt-5">
    <h1>Form Pengaduan</h1>
    <form action="/aduan" method="post">
        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" class="form-control" id="email" name="email" required>
        </div>
        <div class="mb-3">
            <label for="nama" class="form-label">Nama Lengkap</label>
            <input type="text" class="form-control" id="nama" name="nama" required>
        </div>
        <div class = "d-flex justify-content-center align-items-center gap-3">
            <div class="mb-3">
                <label for="nim" class="form-label">NIM</label>
                <input type="text" class="form-control" id="nim" name="nim" required>
            </div>
            <div class="mb-3">
                <label for="nohp" class="form-label">Nomor Handphone</label>
                <input type="text" class="form-control" id="nohp" name="nohp" required>
            </div>
            <div class="mb-3">
            <label for="kelas" class="form-label">Kelas</label>
            <input type="text" class="form-control" id="kelas" name="kelas" required placeholder="contoh: MI-4B">
        </div>
        </div>
        
        <div class="mb-3">
            <label for="aduan" class="form-label">Aduan</label>
            <!-- <input type="text" class="form-control" id="aduan" name="aduan" required> -->
             <textarea name="isi" id="isi" class = "form-control" rows="4" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>