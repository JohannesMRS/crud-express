<div class="container py-5">
    
    <div class="mb-4">
        <a href="/riwayat" class="btn btn-sm btn-outline-secondary shadow-sm rounded-3">
            <i class="bi bi-arrow-left"></i> Kembali ke Daftar
        </a>
    </div>

    <div class="row g-4">
        
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-primary py-4 text-center">
                    <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 80px; height: 80px;">
                        <i class="bi bi-person-fill text-primary fs-1"></i>
                    </div>
                    <h5 class="text-white mt-3 mb-0"><%= detailAduan.nama %></h5>
                    <small class="text-white-50"><%= detailAduan.nim %></small>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label class="text-muted small d-block">Kelas</label>
                        <span class="fw-bold text-dark"><i class="bi bi-door-open me-2 text-primary"></i><%= detailAduan.kelas %></span>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small d-block">Email</label>
                        <span class="fw-bold text-dark"><i class="bi bi-envelope me-2 text-primary"></i><%= detailAduan.email %></span>
                    </div>
                    <div class="mb-0">
                        <label class="text-muted small d-block">Nomor HP / WA</label>
                        <span class="fw-bold text-dark"><i class="bi bi-whatsapp me-2 text-primary"></i><%= detailAduan.nohp %></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    
                    <h5 class="card-title mb-4 d-flex align-items-center fw-bold">
                        <i class="bi bi-chat-left-dots-fill text-primary me-2"></i>
                        Riwayat Aspirasi / Aduan
                    </h5>

                    <% detailAduan.aduan.forEach(a => { %>
                        <div class="p-3 mb-3 rounded-3 bg-light border-start border-primary border-4 shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">Aduan</span>
                                <small class="text-muted">
                                    <div class = "d-inline me-3">
                                    <form action="/riwayat?_method=DELETE" method="post" class = "d-inline">
                                        <input type="hidden" name="_id" id="id" value="<%= detailAduan._id %>">
                                        <button type="submit" onclick="return confirm('Yakin?')" class = "btn btn-none">
                                            <i class="bi bi-trash text-danger fs-6" data-bs-toggle="tooltip" data-bs-placement = "top" title="Hapus"></i>
                                        </button>
                                    </form>
                                    <a href="/riwayat/edit/<%= detailAduan._id %>" class = ""><i class="bi bi-pencil-square text-success fs-6" data-bs-toggle="tooltip" data-bs-placement = "top" title="Edit"></i></a>
                                    </div>
                                        <%= a.date.toLocaleDateString('id-ID') %>
                                </small>
                            </div>
                            <p class="mb-0 text-secondary" style="line-height: 1.6;">
                                <%= a.isi %>
                            </p>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>

    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    body {
        background-color: #f8f9fa;
    }
    .rounded-4 {
        border-radius: 1rem !important;
    }
    .bg-primary-subtle {
        background-color: #e7f1ff !important;
    }
</style>