<div class="container mt-5">
    <div class="row row-cols-1 row-cols-md-4 g-4">
        <% riwayatAduan.forEach(r => { %>
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title"><%= r.nama %> (<%= r.kelas %>)</h5>
                        <p class="card-subtitle mb-2 text-body-secondary">Email: <%= r.email %></p>
                        <p class="card-subtitle mb-2 text-body-secondary">No HP: <%= r.nohp %></p>
                        <a href="/detail/<%= r._id %>" class="card-link">Detail</a>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</div>